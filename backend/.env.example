PORT=3000
# PostgreSQL connection string — required at startup (throws if absent)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/leadpulse
META_VERIFY_TOKEN=replace_with_a_long_random_value
META_APP_SECRET=replace_with_your_meta_app_secret
META_PAGE_ACCESS_TOKEN=replace_with_your_page_access_token
META_GRAPH_API_VERSION=v26.0